{
    "server": {
        "host": "0.0.0.0",
        "port": 2222,
        "max_connections": 10
    },
    "docker": {
        "image": "ssh-honeypot:latest",
        "network": {
            "mode": "custom",
            "name": "honeypot-net",
            "subnet": "192.168.1.0/24",
            "ip_range": "192.168.1.100-192.168.1.200"
        },
        "mem_limit": "512m",
        "cpu_count": 1
    },
    "authorized_users": [
        "admin",
        "developer",
        "support"
    ],
    "logs_dir": "logs",
    "quarantine_dir": "quarantine",
    "monitored_files": [
        "passwords.txt",
        "server_config.yaml",
        "credentials.db",
        "client_list.csv",
        "backup.tar.gz",
        "ssh_keys.txt"
    ],
    "enable_geo_ip": true
}